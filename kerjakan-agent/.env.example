AGENT_ENVIRONMENT=local
AGENT_API_TOKEN=replace-with-a-random-kerjakan-to-agent-secret
AGENT_SCOPE_PUBLIC_KEY_B64=replace-with-base64-public-rsa-key
AGENT_SCOPE_ISSUER=enterprise-ai-ingestion

# Read-only account for the kerjakan-internal PostgreSQL database.
AGENT_DATABASE_URL=postgresql+asyncpg://kerjakan_agent_readonly:replace-with-db-password@127.0.0.1:5433/kerjakan_internal

# Qdrant read-only API key; match INTERNAL_QDRANT_READ_ONLY_API_KEY.
AGENT_QDRANT_URL=http://127.0.0.1:6333
AGENT_QDRANT_API_KEY=replace-with-qdrant-read-only-key
AGENT_QDRANT_COLLECTION=kerjakan-chunks-qwen3-8b-4096-v1
AGENT_QDRANT_TIMEOUT_SECONDS=20

# Must match the indexed embedding profile/model used by kerjakan-internal.
AGENT_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
AGENT_EMBEDDING_API_KEY=replace-with-embedding-api-key
AGENT_EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
AGENT_EMBEDDING_PROFILE=qwen3-embedding-8b-4096-v1
AGENT_EMBEDDING_DIMENSIONS=4096
AGENT_EMBEDDING_TIMEOUT_SECONDS=60
AGENT_MIN_RELEVANCE_SCORE=0.25

# Any OpenAI-compatible chat completion endpoint can be used.
AGENT_CHAT_BASE_URL=https://openrouter.ai/api/v1
AGENT_CHAT_API_KEY=replace-with-the-chat-provider-key
AGENT_CHAT_MODEL=replace-with-provider/model-id
AGENT_CHAT_TIMEOUT_SECONDS=90
AGENT_MAX_CONTEXT_CHUNKS=8
