POSTGRES_DB=retriv_api
POSTGRES_USER=retriv_api
POSTGRES_PASSWORD=change-this-postgres-password
APP_ENVIRONMENT=local
MINIO_ENDPOINT_URL=http://minio:9000

# Host-run application connections. Keep the passwords aligned with the values below.
APP_DATABASE_URL=postgresql+asyncpg://retriv_api:change-this-postgres-password@127.0.0.1:5432/retriv_api
APP_S3_ENDPOINT_URL=http://127.0.0.1:9000
APP_S3_ACCESS_KEY=ingestion-api
APP_S3_SECRET_KEY=change-this-minio-app-password
APP_S3_BUCKET=raw-documents
APP_CLAMD_HOST=127.0.0.1
APP_CLAMD_PORT=3310
APP_CORS_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'
# Match APP_AGENT_API_TOKEN in agent/.env.
APP_AGENT_BASE_URL=http://127.0.0.1:8090
APP_AGENT_API_TOKEN=replace-with-an-independent-32-character-agent-api-token
APP_AGENT_SCOPE_PRIVATE_KEY_B64=replace-with-base64-private-rsa-key
APP_AGENT_SCOPE_TTL_SECONDS=900
APP_AGENT_TIMEOUT_SECONDS=600
# Match APP_PROCESSING_API_TOKEN with INTERNAL_API_TOKEN in ingest/.env.
APP_PROCESSING_API_BASE_URL=http://127.0.0.1:8082
APP_PROCESSING_API_TOKEN=replace-with-the-internal-api-token

# Host-run outbox relay. The database URL is mapped from APP_DATABASE_URL at runtime.
OUTBOX_ENVIRONMENT=local
OUTBOX_TARGET_URL=http://127.0.0.1:8082/internal/events
OUTBOX_SIGNING_KEY_ID=local-outbox-v1
OUTBOX_SIGNING_SECRET=change-this-to-an-independent-32-character-secret
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=20
OUTBOX_REQUEST_TIMEOUT_SECONDS=10
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_RETENTION_DAYS=7
OUTBOX_DATABASE_URL=postgresql+asyncpg://retriv_api:change-this-postgres-password@127.0.0.1:5432/retriv_api

MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=change-this-minio-root-password
MINIO_APP_USER=ingestion-api
MINIO_APP_PASSWORD=change-this-minio-app-password
MINIO_INTERNAL_USER=context-service
MINIO_INTERNAL_PASSWORD=change-this-minio-internal-password
MINIO_BUCKET=raw-documents
MINIO_CONTEXT_BUCKET=context-documents
MINIO_MANIFEST_BUCKET=migration-manifests
MIGRATION_MANIFEST_PREFIX=bootstrap/
MINIO_MANIFEST_RETENTION_DAYS=7
MINIO_MANIFEST_READER_USER=migration-reader
MINIO_MANIFEST_READER_PASSWORD=change-this-manifest-reader-password
MINIO_MANIFEST_WRITER_USER=migration-writer
MINIO_MANIFEST_WRITER_PASSWORD=change-this-manifest-writer-password

# S3 URI for the one-shot provisioning job.
MIGRATION_MANIFEST_URI=s3://migration-manifests/bootstrap/users-v1.json

# Generate with: openssl rand -hex 32 (64 hexadecimal characters)
APP_JWT_SECRET=change-this-to-at-least-64-random-characters
