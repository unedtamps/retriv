INTERNAL_ENVIRONMENT=local
INTERNAL_DATABASE_URL=postgresql+asyncpg://retriv_ingest:change-this-postgres-password@127.0.0.1:5433/retriv_ingest

INTERNAL_WEBHOOK_KEY_ID=local-outbox-v1
INTERNAL_WEBHOOK_SECRET=change-this-to-an-independent-32-character-secret
INTERNAL_WEBHOOK_MAX_AGE_SECONDS=300
INTERNAL_API_TOKEN=change-this-to-an-independent-internal-api-token

INTERNAL_S3_ENDPOINT_URL=http://127.0.0.1:9000
INTERNAL_S3_CONTAINER_ENDPOINT_URL=http://minio:9000
INTERNAL_S3_ACCESS_KEY=context-service
INTERNAL_S3_SECRET_KEY=change-this-minio-internal-password
INTERNAL_S3_RAW_BUCKET=raw-documents
INTERNAL_S3_ARTIFACT_BUCKET=context-documents
INTERNAL_S3_REGION=us-east-1

INTERNAL_PIPELINE_VERSION=2026.1
# The Docker worker defaults to baked model artifacts at /opt/docling-models.
# INTERNAL_DOCLING_ARTIFACTS_PATH=/path/to/docling-models
INTERNAL_OCR_LANGUAGES='["ind","eng"]'
INTERNAL_CHUNK_MAX_TOKENS=700
INTERNAL_MAX_SOURCE_BYTES=52428800
INTERNAL_MAX_CHUNKS_PER_DOCUMENT=10000
INTERNAL_MAX_ARTIFACT_BYTES=104857600
INTERNAL_MAX_EXTRACTED_TEXT_BYTES=52428800
INTERNAL_MAX_CHUNK_PAYLOAD_BYTES=104857600
INTERNAL_PROCESSING_TIMEOUT_SECONDS=1800
INTERNAL_ARTIFACT_RECONCILIATION_INTERVAL_SECONDS=300
INTERNAL_PARSER_MEMORY_LIMIT_BYTES=8589934592
INTERNAL_PARSER_MAX_PROCESSES=4096

# OpenAI-compatible embedding service. Rotate any token that has been shared publicly.
INTERNAL_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
INTERNAL_EMBEDDING_CONTAINER_BASE_URL=http://host.docker.internal:1234/v1
INTERNAL_EMBEDDING_API_KEY=replace-with-a-rotated-embedding-api-key
INTERNAL_EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
INTERNAL_EMBEDDING_PROFILE=qwen3-embedding-8b-4096-v1
INTERNAL_EMBEDDING_DIMENSIONS=4096
INTERNAL_EMBEDDING_BATCH_SIZE=16
INTERNAL_EMBEDDING_TIMEOUT_SECONDS=120
INTERNAL_EMBEDDING_RECONCILIATION_INTERVAL_SECONDS=300

# Qdrant is bound to loopback on the host and requires this independent key.
INTERNAL_QDRANT_URL=http://127.0.0.1:6333
INTERNAL_QDRANT_API_KEY=replace-with-an-independent-qdrant-api-key
INTERNAL_QDRANT_READ_ONLY_API_KEY=replace-with-an-independent-qdrant-read-only-key
INTERNAL_QDRANT_COLLECTION=retriv-chunks-qwen3-8b-4096-v1
INTERNAL_QDRANT_TIMEOUT_SECONDS=30
INTERNAL_QDRANT_VECTORS_ON_DISK=true

# Infrastructure-only Docker Compose settings.
INTERNAL_POSTGRES_DB=retriv_ingest
INTERNAL_POSTGRES_USER=retriv_ingest
INTERNAL_POSTGRES_PASSWORD=change-this-postgres-password
INTERNAL_DOCKER_SUBNET=10.254.0.0/24
