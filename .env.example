# Retriv configuration
#
# Copy to .env and fill in the CHANGE ME values. Every secret here is a
# placeholder: nothing in this file is a working credential.
#
# One application, one Settings class, one RETRIV_ prefix. The worker is
# the only separate process; it reads the same settings with
# RETRIV_COMPONENT=worker, and compose gives it only the subset it needs.

# --- core ---------------------------------------------------------------
RETRIV_APP_NAME=retriv
RETRIV_ENVIRONMENT=local
RETRIV_DATABASE_URL=postgresql+asyncpg://retriv:CHANGE_ME@127.0.0.1:5432/retriv

# --- auth ---------------------------------------------------------------
# CHANGE ME: at least 64 random characters. Rotating this signs every
# existing session out, which is the intended effect.
RETRIV_JWT_SECRET=CHANGE_ME
RETRIV_JWT_ALGORITHM=HS256
RETRIV_JWT_ISSUER=retriv
RETRIV_JWT_AUDIENCE=retriv
RETRIV_ACCESS_TOKEN_MINUTES=60
RETRIV_CORS_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'

# --- object storage -----------------------------------------------------
# Two identities, two buckets, and they are not interchangeable. The app
# writes raw documents; the worker reads those and writes extracted
# artifacts. Compose gives the worker the artifact pair, so a compromise
# of either process does not grant the other's write access.
RETRIV_S3_ENDPOINT_URL=http://127.0.0.1:9000
RETRIV_S3_ACCESS_KEY=retriv-api
RETRIV_S3_SECRET_KEY=CHANGE_ME
RETRIV_S3_ARTIFACT_ACCESS_KEY=retriv-worker
RETRIV_S3_ARTIFACT_SECRET_KEY=CHANGE_ME
RETRIV_S3_RAW_BUCKET=raw-documents
RETRIV_S3_ARTIFACT_BUCKET=context-documents
RETRIV_S3_REGION=us-east-1
# Only used inside the worker container, where the host is not localhost.
RETRIV_S3_CONTAINER_ENDPOINT_URL=http://minio:9000

# --- infrastructure -----------------------------------------------------
# CHANGE ME: must match POSTGRES_PASSWORD below.
POSTGRES_DB=retriv
POSTGRES_USER=retriv
POSTGRES_PASSWORD=CHANGE_ME

# CHANGE ME: the MinIO root, API, and worker passwords must all differ.
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT_URL=http://minio:9000

# CHANGE ME: two distinct keys. The read-only one is what the app uses to
# answer questions; the writable one belongs to the worker. Mint them with
# `openssl rand -hex 32`.
RETRIV_QDRANT_API_KEY=CHANGE_ME
RETRIV_QDRANT_READ_ONLY_API_KEY=CHANGE_ME
RETRIV_DOCKER_SUBNET=10.254.0.0/24

# --- bootstrap admin -----------------------------------------------------
# The API creates this account on startup if it does not exist, and keeps its
# password in sync with this value. Set both or neither; leave both empty when
# the deployment already has its users. Rotating the password here bumps
# auth_version, which signs out every session issued under the old password.
RETRIV_BOOTSTRAP_ADMIN_USERNAME=admin
# CHANGE ME: at least 12 bytes. "change-this" is rejected in production.
RETRIV_BOOTSTRAP_ADMIN_PASSWORD=change-this-bootstrap-admin-password

# --- scanning and uploads -----------------------------------------------
RETRIV_ANTIVIRUS_ENABLED=true
RETRIV_CLAMD_HOST=127.0.0.1
RETRIV_CLAMD_PORT=3310
RETRIV_MAX_UPLOAD_BYTES=52428800
RETRIV_MAX_CONCURRENT_UPLOADS=2

# --- extraction pipeline ------------------------------------------------
RETRIV_PIPELINE_VERSION=2026.1
RETRIV_OCR_LANGUAGES='["ind","eng"]'
# Reject an extraction that kept less than this fraction of the text the source file's
# own text layer carries. Guards against silently indexing a partially parsed document.
RETRIV_MIN_EXTRACTION_COVERAGE=0.6
RETRIV_CHUNK_MAX_TOKENS=700
RETRIV_CHUNK_TOKENIZER=cl100k_base
RETRIV_MAX_SOURCE_BYTES=52428800
RETRIV_MAX_CHUNKS_PER_DOCUMENT=10000
RETRIV_MAX_ARTIFACT_BYTES=104857600
RETRIV_MAX_EXTRACTED_TEXT_BYTES=52428800
RETRIV_MAX_CHUNK_PAYLOAD_BYTES=104857600
RETRIV_DOCLING_ARTIFACTS_PATH=/opt/docling-models
RETRIV_PROCESSING_TIMEOUT_SECONDS=1800
RETRIV_PARSER_MEMORY_LIMIT_BYTES=8589934592
RETRIV_PARSER_MAX_PROCESSES=4096
RETRIV_PROCESSING_POLL_INTERVAL_SECONDS=2
RETRIV_ARTIFACT_RECONCILIATION_INTERVAL_SECONDS=300
RETRIV_PROCESSING_LEASE_SECONDS=1800
RETRIV_PROCESSING_MAX_ATTEMPTS=3
RETRIV_PROCESSING_RETRY_BASE_SECONDS=5
RETRIV_PROCESSING_RETRY_MAX_SECONDS=300

# --- embeddings and vectors ---------------------------------------------
# One embedding profile, shared by the worker that writes vectors and the
# app that reads them. If these two disagree, retrieval silently finds
# nothing, so change them together or not at all.
# CHANGE ME: your LM Studio token.
RETRIV_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
RETRIV_EMBEDDING_API_KEY=change-this-lm-studio-token-do-not-use-in-production
RETRIV_EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
RETRIV_EMBEDDING_PROFILE=qwen3-embedding-8b-4096-v1
RETRIV_EMBEDDING_DIMENSIONS=4096
RETRIV_EMBEDDING_BATCH_SIZE=16
RETRIV_EMBEDDING_TIMEOUT_SECONDS=120
RETRIV_EMBEDDING_RECONCILIATION_INTERVAL_SECONDS=300
# Only used inside the worker container.
RETRIV_EMBEDDING_CONTAINER_BASE_URL=http://host.docker.internal:1234/v1

# --- vision --------------------------------------------------------------
# The pictures inside a document are described by a multimodal model behind an
# OpenAI-compatible API, and the description is folded into the chunk that
# holds the picture. A chart's values are in the pixels, not in any text
# layer, so without this a question about the chart has nothing to match.
#
# The endpoint may be given as a bare API root or as the full chat endpoint;
# "/chat/completions" is appended when it is missing.
# CHANGE ME: your gateway token.
RETRIV_VLM_BASE_URL=https://zenmux.ai/api/v1/chat/completions
RETRIV_VLM_API_KEY=change-this-vision-gateway-token-do-not-use-in-production
RETRIV_VLM_MODEL=minimax/minimax-m3.1-flash
RETRIV_VLM_TIMEOUT_SECONDS=120
# The answer budget for one picture, reasoning included. This is a ceiling,
# not a limit on how long the model may think: the model stops on its own
# well below it. It matters only when it is set below what the model wanted,
# because then the endpoint cuts it off mid-thought and hands back nothing.
# When that happens the budget goes up and the same picture is asked again,
# up to the ceiling below.
RETRIV_VLM_MAX_TOKENS=8192
RETRIV_VLM_MAX_TOKENS_CEILING=131072
# How many pictures of one document may be described. The rest are left
# undescribed rather than paid for. Zero means no cap.
RETRIV_VLM_MAX_IMAGES_PER_DOCUMENT=100
# How many descriptions are requested at the same time.
RETRIV_VLM_MAX_CONCURRENCY=4
# A description longer than this would push the chunk it lands in well past
# the chunking budget, and the extra words are noise.
RETRIV_VLM_MAX_DESCRIPTION_CHARS=1200

# How long the worker waits for the model to answer before it hands the run
# back for another attempt. The base and max are the backoff curve between
# attempts. This is the budget for one attempt, not for the whole document.
RETRIV_MODEL_WAIT_BASE_SECONDS=5
RETRIV_MODEL_WAIT_MAX_SECONDS=60
RETRIV_MODEL_WAIT_TIMEOUT_SECONDS=3600

# Turn the whole stage off. Off means the parser is not asked to render
# pictures at all, and the document is indexed exactly as it was before this
# stage existed.
RETRIV_IMAGE_PROCESSING_ENABLED=true
# How many times larger than the page a picture is rendered. 2.0 puts a
# 300x150 point figure at 600x300 pixels, enough to read axis labels.
RETRIV_IMAGE_RENDER_SCALE=2.0
# Pictures whose rendered area is below this are not worth an API call: they
# are logos, rules, bullets and ornaments. The threshold is in rendered
# pixels, so it moves with the render scale.
RETRIV_IMAGE_MIN_PIXELS=10000
RETRIV_MAX_IMAGE_BYTES=5242880
RETRIV_MAX_TOTAL_IMAGE_BYTES=52428800

RETRIV_QDRANT_URL=http://127.0.0.1:6333
RETRIV_QDRANT_COLLECTION=retriv-chunks-qwen3-8b-4096-v1
RETRIV_QDRANT_TIMEOUT_SECONDS=30
RETRIV_QDRANT_VECTORS_ON_DISK=true

# --- retrieval ----------------------------------------------------------
# MAX_CONTEXT_CHUNKS bounds how many similarity matches one search may return.
RETRIV_MAX_CONTEXT_CHUNKS=4
RETRIV_MIN_RELEVANCE_SCORE=0.25

# Total sources one search may return, completed sections included. It must be
# larger than MAX_CONTEXT_CHUNKS or section completion can never run: a search
# that filled its match quota would have no room left, which is exactly the
# situation where a heading arrives without the text underneath it. 1 to 40.
RETRIV_MAX_CONTEXT_SOURCES=12

# Chunks one anchored section may contribute when the search named a section
# without returning all of it. Per section, not per search, so a long section
# cannot crowd out the ones ranked below it. 0 turns completion off. 0 to 20.
RETRIV_SECTION_EXPAND_CHUNKS=4

# Tokens one read_document window may return. The count of chunks is the wrong
# unit to bound on: chunk sizes run from about 5 tokens for a bare heading to
# the 700-token ceiling, so any fixed count is either wasteful on a
# short-headed document or explosive on a dense one. 500 to 64000.
RETRIV_NAVIGATION_TOKEN_BUDGET=8000

# How long the download_document tool's signed link stays usable, in seconds.
# It cannot be revoked once issued, so keep it short. 30 to 3600.
RETRIV_MCP_DOWNLOAD_LINK_TTL_SECONDS=300

# --- CSV row queries ----------------------------------------------------
# Leave RETRIV_SQL_DATABASE_URL unset to turn the row-query tool OFF. An
# unset value cannot be misread as "no restriction": the tool is simply never
# registered, so the model has no way to reach a table.
#
# When set it must point at a role WITHOUT superuser and WITHOUT BYPASSRLS.
# Row-level security does not constrain either of those, so a DSN aimed at
# the application role would see every workspace's rows while appearing
# properly scoped. The app refuses to start rather than accept one.
#
# The role itself is created for you. `docker compose up` runs a one-shot
# postgres-init service that creates RETRIV_SQL_READER_USER, pins it to
# NOSUPERUSER NOBYPASSRLS, and grants it SELECT on document_rows, documents
# and processing_runs. Nothing to run by hand, and re-running it repairs a role
# whose password was rotated here.
#
# The password appears twice, which is a real hazard: this one is what the role
# is created with, and the one inside the DSN below is what the app connects
# with. They must be the same value. Change one and the app fails to start with
# "RETRIV_SQL_DATABASE_URL is configured but unusable"; change both together.
#
# To use a password that needs URL-encoding, percent-encode it here and there.
RETRIV_SQL_READER_USER=retriv_reader
RETRIV_SQL_READER_PASSWORD=CHANGE_ME
#RETRIV_SQL_DATABASE_URL=postgresql+asyncpg://retriv_reader:CHANGE_ME@postgres:5432/retriv
RETRIV_SQL_STATEMENT_TIMEOUT_MS=5000
RETRIV_SQL_MAX_RESULT_ROWS=200
